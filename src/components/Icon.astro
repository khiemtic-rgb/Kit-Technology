---
import { iconPaths, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, strokeWidth = 1.6 } = Astro.props;
const shape = iconPaths[name] ?? iconPaths.platform;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {shape.map((d) => <path d={d} />)}
</svg>
