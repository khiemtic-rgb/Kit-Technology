---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { getAlternateLocalePath, getLocaleFromPath } from '../lib/routes';
import { pageUrl } from '../lib/site-map';
import { absoluteUrl } from '../lib/site';

interface Props {
  locale?: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = localeProp ?? getLocaleFromPath(Astro.url.pathname);
const vi = locale === 'vi';
const m = t(locale);
const f = m.footer;
const year = new Date().getFullYear();
const contactHref = vi ? '/vi/lien-he/' : '/en/contact/';
const newsletterNext = absoluteUrl(`${contactHref}?sent=1#contact-form`);
const alternatePath = getAlternateLocalePath(Astro.url.pathname);
const alternateLabel = vi ? 'English' : 'Tiếng Việt';

const columns = [
  {
    title: f.columns.platform,
    links: [
      { label: vi ? 'Kiến trúc' : 'Architecture', href: pageUrl(locale, vi ? 'cong-nghe/kien-truc-he-thong' : 'technology/architecture') },
      { label: vi ? 'API Platform' : 'API Platform', href: pageUrl(locale, vi ? 'cong-nghe' : 'technology') },
      { label: 'AI Platform', href: pageUrl(locale, vi ? 'cong-nghe/ai' : 'technology/ai') },
      { label: vi ? 'Bảo mật' : 'Security', href: pageUrl(locale, vi ? 'cong-nghe' : 'technology') },
      { label: 'Cloud', href: pageUrl(locale, vi ? 'cong-nghe/cloud' : 'technology/cloud') },
    ],
  },
  {
    title: f.columns.products,
    links: [
      { label: 'Novixa', href: pageUrl(locale, vi ? 'san-pham/novixa' : 'products/novixa') },
      { label: 'Famixa', href: pageUrl(locale, vi ? 'san-pham/tuong-lai' : 'products/future') },
      { label: 'Spa OS', href: pageUrl(locale, vi ? 'san-pham/tuong-lai' : 'products/future') },
      { label: 'Clinic OS', href: pageUrl(locale, vi ? 'san-pham/tuong-lai' : 'products/future') },
      { label: vi ? 'Sản phẩm khác' : 'More Products', href: pageUrl(locale, vi ? 'san-pham' : 'products') },
    ],
  },
  {
    title: f.columns.solutions,
    links: [
      { label: vi ? 'Y tế' : 'Healthcare', href: pageUrl(locale, vi ? 'giai-phap/healthcare' : 'solutions/healthcare') },
      { label: vi ? 'Bán lẻ' : 'Retail', href: pageUrl(locale, vi ? 'giai-phap/retail' : 'solutions/retail') },
      { label: vi ? 'Làm đẹp' : 'Beauty', href: pageUrl(locale, vi ? 'giai-phap' : 'solutions') },
      { label: vi ? 'Nông nghiệp' : 'Agriculture', href: pageUrl(locale, vi ? 'du-an' : 'projects') },
      { label: vi ? 'Doanh nghiệp' : 'Enterprise', href: pageUrl(locale, vi ? 'giai-phap/enterprise-platform' : 'solutions/enterprise-platform') },
    ],
  },
  {
    title: f.columns.company,
    links: [
      { label: vi ? 'Về chúng tôi' : 'About Us', href: pageUrl(locale, vi ? 'gioi-thieu' : 'company') },
      { label: vi ? 'Tuyển dụng' : 'Careers', href: pageUrl(locale, vi ? 'tuyen-dung' : 'careers') },
      { label: vi ? 'Đối tác' : 'Partners', href: pageUrl(locale, vi ? 'gioi-thieu' : 'company') },
      { label: vi ? 'Tin tức' : 'Newsroom', href: pageUrl(locale, vi ? 'blog' : 'insights') },
      { label: m.nav.contact, href: contactHref },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="/images/logo-kit.png" alt={m.meta.siteName} width="180" height="44" loading="lazy" decoding="async" />
      <p class="footer-desc">{f.desc}</p>
      <div class="footer-social" aria-label="Social">
        <span title="Facebook">{f.social.facebook}</span>
        <span title="LinkedIn">{f.social.linkedin}</span>
        <span title="GitHub">{f.social.github}</span>
      </div>
    </div>

    {
      columns.map((column) => (
        <div class="footer-col">
          <p class="footer-col-title">{column.title}</p>
          {column.links.map((linkItem) => (
            <a href={linkItem.href}>{linkItem.label}</a>
          ))}
        </div>
      ))
    }

    <div class="footer-col footer-newsletter">
      <p class="footer-col-title">{f.newsletter.title}</p>
      <p class="footer-newsletter-desc">{f.newsletter.desc}</p>
      <form
        class="footer-newsletter-form"
        method="POST"
        action={`https://formsubmit.co/${encodeURIComponent(m.contact.emailAddress)}`}
      >
        <input type="hidden" name="_subject" value={f.newsletter.subject} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={newsletterNext} />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="newsletter-email">{f.newsletter.placeholder}</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={f.newsletter.placeholder}
        />
        <button type="submit" aria-label={f.newsletter.cta}>
          <Icon name="arrowRight" size={18} />
        </button>
      </form>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {f.rights}</p>
    <div class="footer-bottom-links">
      <a href={alternatePath} hreflang={vi ? 'en' : 'vi'}>{alternateLabel}</a>
      <span>{f.since}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #020b1a;
    color: #9fb3ce;
    padding: 3rem 0 1.35rem;
    font-size: 0.88rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem 1.35rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 2rem;
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1.45fr repeat(4, 0.85fr) 1.2fr;
    }
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 1100px) {
    .footer-brand {
      grid-column: auto;
    }
  }

  .footer-logo {
    height: 38px;
    width: auto;
    margin-bottom: 0.9rem;
    filter: brightness(0) invert(1);
  }

  .footer-desc {
    margin: 0 0 1rem;
    max-width: 34ch;
    line-height: 1.65;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: #7d93ae;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col-title {
    margin: 0 0 0.55rem;
    font-weight: 700;
    color: #fff;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-col a {
    color: #9fb3ce;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-newsletter {
    grid-column: 1 / -1;
  }

  @media (min-width: 1100px) {
    .footer-newsletter {
      grid-column: auto;
    }
  }

  .footer-newsletter-desc {
    margin: 0 0 0.75rem;
    line-height: 1.6;
  }

  .footer-newsletter-form {
    display: flex;
    gap: 0.4rem;
    max-width: 340px;
  }

  .footer-newsletter-form input[type='email'] {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    font: inherit;
  }

  .footer-newsletter-form input[type='email']::placeholder {
    color: #7d93ae;
  }

  .footer-newsletter-form button {
    display: grid;
    place-items: center;
    width: 2.7rem;
    border: none;
    border-radius: 10px;
    background: var(--color-primary);
    color: #fff;
    cursor: pointer;
  }

  .footer-newsletter-form button:hover {
    background: var(--color-primary-dark);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.78rem;
    color: #7d93ae;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .footer-bottom-links a {
    color: #9fb3ce;
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: #fff;
  }
</style>
