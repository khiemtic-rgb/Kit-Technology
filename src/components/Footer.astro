---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { getAlternateLocalePath, getLocaleFromPath } from '../lib/routes';
import { pageUrl } from '../lib/site-map';
import { absoluteUrl } from '../lib/site';

interface Props {
  locale?: Locale;
}

const { locale: localeProp } = Astro.props;
const locale = localeProp ?? getLocaleFromPath(Astro.url.pathname);
const vi = locale === 'vi';
const m = t(locale);
const f = m.footer;
const year = new Date().getFullYear();
const contactHref = vi ? '/vi/lien-he/' : '/en/contact/';
const newsletterNext = absoluteUrl(`${contactHref}?sent=1#contact-form`);
const alternatePath = getAlternateLocalePath(Astro.url.pathname);

const columns = [
  {
    title: f.columns.solutions,
    links: [
      { label: vi ? 'Sản phẩm' : 'Products', href: pageUrl(locale, vi ? 'san-pham' : 'products') },
      { label: 'Novixa', href: vi ? 'https://novixa.vn/vi' : 'https://novixa.vn/en', external: true },
      { label: 'Famixa', href: vi ? 'https://famixa.vn/vi' : 'https://famixa.vn/en', external: true },
    ],
  },
  {
    title: f.columns.platform,
    links: [
      { label: 'KIT Platform', href: pageUrl(locale, vi ? 'nen-tang' : 'platform') },
      { label: vi ? 'Công nghệ' : 'Technology', href: pageUrl(locale, vi ? 'cong-nghe' : 'technology') },
      {
        label: vi ? 'Kiến trúc hệ thống' : 'System Architecture',
        href: pageUrl(locale, vi ? 'cong-nghe/kien-truc-he-thong' : 'technology/architecture'),
      },
    ],
  },
  {
    title: f.columns.company,
    links: [
      { label: vi ? 'Về KIT' : 'About KIT', href: pageUrl(locale, vi ? 'gioi-thieu' : 'company') },
      { label: vi ? 'Kiến thức' : 'Insights', href: pageUrl(locale, vi ? 'blog' : 'insights') },
      { label: vi ? 'Tuyển dụng' : 'Careers', href: pageUrl(locale, vi ? 'tuyen-dung' : 'careers') },
      { label: m.nav.contact, href: contactHref },
    ],
  },
];

const social = [
  { label: f.social.facebook, href: 'https://www.facebook.com/kitplatform', icon: 'facebook' as const },
  { label: 'Email', href: `mailto:${m.contact.emailAddress}`, icon: 'mail' as const },
];
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="footer-logo-link" href={vi ? '/vi/' : '/en/'}>
        <img
          class="footer-logo"
          src="/images/logo-kit-footer.png"
          alt={m.meta.siteName}
          width="200"
          height="48"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer-tagline">{f.tagline}</p>
      <p class="footer-desc">{f.desc}</p>
      <div class="footer-social" aria-label="Social">
        {
          social.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={item.label}
            >
              <Icon name={item.icon} size={20} />
            </a>
          ))
        }
      </div>
    </div>

    {
      columns.map((column) => (
        <nav class="footer-col" aria-label={column.title}>
          <p class="footer-col-title">{column.title}</p>
          <ul class="footer-links">
            {column.links.map((linkItem) => (
              <li>
                <a
                  href={linkItem.href}
                  target={'external' in linkItem && linkItem.external ? '_blank' : undefined}
                  rel={'external' in linkItem && linkItem.external ? 'noopener noreferrer' : undefined}
                >
                  {linkItem.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer-col footer-newsletter">
      <p class="footer-col-title">{f.newsletter.title}</p>
      <p class="footer-newsletter-desc">{f.newsletter.desc}</p>
      <form
        class="footer-newsletter-form"
        method="POST"
        action={`https://formsubmit.co/${encodeURIComponent(m.contact.emailAddress)}`}
      >
        <input type="hidden" name="_subject" value={f.newsletter.subject} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={newsletterNext} />
        <input type="text" name="_honey" hidden tabindex="-1" autocomplete="off" />
        <label class="sr-only" for="newsletter-email">{f.newsletter.placeholder}</label>
        <div class="footer-newsletter-field">
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={f.newsletter.placeholder}
          />
          <button type="submit" aria-label={f.newsletter.cta}>
            <Icon name="arrowRight" size={18} />
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {f.rights}</p>
    <div class="footer-bottom-links">
      <a href={alternatePath} hreflang={vi ? 'en' : 'vi'}>{vi ? 'English' : 'Tiếng Việt'}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #081b3a;
    color: #9fb3ce;
    padding: 4rem 0 1.35rem;
    font-size: 0.9rem;
  }

  .footer-top {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    margin-bottom: 2.5rem;
    align-items: start;
  }

  /* Tablet: brand full width, 3 nav cols, newsletter full */
  @media (min-width: 760px) and (max-width: 1099px) {
    .footer-top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-newsletter {
      grid-column: 1 / -1;
      max-width: 420px;
    }
  }

  /* Desktop: one balanced row */
  @media (min-width: 1100px) {
    .footer-top {
      grid-template-columns:
        minmax(240px, 1.4fr)
        minmax(100px, 0.7fr)
        minmax(120px, 0.85fr)
        minmax(110px, 0.8fr)
        minmax(240px, 1.25fr);
      column-gap: 1.75rem;
      row-gap: 0;
    }
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.9rem;
    text-decoration: none;
  }

  .footer-logo {
    display: block;
    height: 44px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    object-position: left center;
  }

  .footer-tagline {
    margin: 0 0 0.55rem;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .footer-desc {
    margin: 0 0 1.25rem;
    max-width: 34ch;
    line-height: 1.65;
    color: #9fb3ce;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .footer-social a {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #f3f7fc;
    text-decoration: none;
  }

  .footer-social a:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .footer-col-title {
    margin: 0 0 0.85rem;
    font-weight: 700;
    color: #fff;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-links a,
  .footer-col a {
    color: #9fb3ce;
    text-decoration: none;
    line-height: 1.45;
  }

  .footer-links a:hover,
  .footer-col a:hover {
    color: #fff;
  }

  .footer-newsletter-desc {
    margin: 0 0 0.95rem;
    line-height: 1.6;
    color: #9fb3ce;
  }

  .footer-newsletter-field {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
    max-width: 360px;
  }

  .footer-newsletter-field input[type='email'] {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 0.95rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font: inherit;
  }

  .footer-newsletter-field input[type='email']::placeholder {
    color: #7d93ae;
  }

  .footer-newsletter-field button {
    display: grid;
    place-items: center;
    width: 3rem;
    flex: 0 0 3rem;
    border: none;
    border-radius: 12px;
    background: #0a66ff;
    color: #fff;
    cursor: pointer;
  }

  .footer-newsletter-field button:hover {
    background: #084ecc;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    padding-top: 1.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: #7d93ae;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom-links a {
    color: #9fb3ce;
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: #fff;
  }
</style>
