---
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

const nodes: { icon: IconName; angle: number }[] = [
  { icon: 'users', angle: -115 },
  { icon: 'analytics', angle: -35 },
  { icon: 'security', angle: 35 },
  { icon: 'healthcare', angle: 115 },
];
---

<div class="chub" aria-hidden="true">
  <div class="chub-glow"></div>
  <div class="chub-ring r1"></div>
  <div class="chub-ring r2"></div>
  <div class="chub-ring r3"></div>

  <div class="chub-pedestal">
    <span class="chub-step s1"></span>
    <span class="chub-step s2"></span>
    <span class="chub-step s3"></span>
  </div>

  <div class="chub-cube">
    <strong>KIT<br />TECHNOLOGY</strong>
  </div>

  <ul class="chub-nodes">
    {
      nodes.map((node) => {
        const rad = (node.angle * Math.PI) / 180;
        const left = 50 + Math.cos(rad) * 38;
        const top = 46 + Math.sin(rad) * 34;
        return (
          <li style={`left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`}>
            <span class="chub-tile">
              <Icon name={node.icon} size={28} strokeWidth={2} />
            </span>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .chub {
    --hub: min(100%, 360px);
    position: relative;
    width: var(--hub);
    aspect-ratio: 1 / 0.92;
    margin-left: auto;
  }

  .chub-glow {
    position: absolute;
    left: 50%;
    top: 48%;
    width: 58%;
    height: 58%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(10, 102, 255, 0.22), transparent 70%);
  }

  .chub-ring {
    position: absolute;
    left: 50%;
    top: 52%;
    translate: -50% -50%;
    border: 1.5px solid rgba(10, 102, 255, 0.14);
    border-radius: 50%;
  }

  .chub-ring.r1 {
    width: 72%;
    height: 34%;
  }

  .chub-ring.r2 {
    width: 58%;
    height: 26%;
  }

  .chub-ring.r3 {
    width: 44%;
    height: 18%;
  }

  .chub-pedestal {
    position: absolute;
    left: 50%;
    bottom: 14%;
    translate: -50% 0;
    width: 56%;
    height: 28%;
    z-index: 1;
  }

  .chub-step {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: linear-gradient(180deg, #e8f1ff, #cfe1ff);
    box-shadow: 0 8px 18px rgba(10, 102, 255, 0.1);
  }

  .chub-step.s1 {
    bottom: 0;
    width: 100%;
    height: 28%;
  }

  .chub-step.s2 {
    bottom: 18%;
    width: 78%;
    height: 28%;
  }

  .chub-step.s3 {
    bottom: 36%;
    width: 56%;
    height: 28%;
  }

  .chub-cube {
    position: absolute;
    left: 50%;
    top: 34%;
    translate: -50% -50%;
    z-index: 3;
    width: 7.2rem;
    height: 7.2rem;
    display: grid;
    place-items: center;
    text-align: center;
    border-radius: 1.1rem;
    color: #0a66ff;
    background: linear-gradient(160deg, #ffffff 0%, #eef5ff 55%, #dceaff 100%);
    border: 1px solid rgba(10, 102, 255, 0.14);
    box-shadow:
      0 18px 36px rgba(10, 102, 255, 0.18),
      0 0 0 8px rgba(255, 255, 255, 0.55);
    animation: chub-float 4.8s ease-in-out infinite;
  }

  .chub-cube strong {
    font-size: var(--hub-cube-font);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .chub-nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    z-index: 4;
  }

  .chub-nodes li {
    position: absolute;
    width: 0;
    height: 0;
  }

  .chub-tile {
    display: grid;
    place-items: center;
    width: var(--hub-node-tile);
    height: var(--hub-node-tile);
    margin: calc(var(--hub-node-tile) / -2) 0 0 calc(var(--hub-node-tile) / -2);
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(145deg, #4d93ff, #0a66ff);
    box-shadow: 0 10px 22px rgba(10, 102, 255, 0.28);
    animation: chub-float 4.6s ease-in-out infinite;
  }

  .chub-tile :global(svg) {
    width: calc(var(--hub-node-icon) * 0.85);
    height: calc(var(--hub-node-icon) * 0.85);
  }

  .chub-nodes li:nth-child(2) .chub-tile {
    animation-delay: 0.5s;
  }

  .chub-nodes li:nth-child(3) .chub-tile {
    animation-delay: 1s;
  }

  .chub-nodes li:nth-child(4) .chub-tile {
    animation-delay: 1.5s;
  }

  @keyframes chub-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 640px) {
    .chub {
      --hub: min(100%, 300px);
      margin-inline: auto;
    }

    .chub-cube {
      width: 5.6rem;
      height: 5.6rem;
    }

    .chub-cube strong {
      font-size: 0.64rem;
    }

    .chub-tile {
      width: 3.15rem;
      height: 3.15rem;
      margin: -1.575rem 0 0 -1.575rem;
    }

    .chub-tile :global(svg) {
      width: 1.35rem;
      height: 1.35rem;
    }
  }
</style>
