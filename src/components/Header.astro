---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { getAlternateLocalePath, contactPath, getLocaleFromPath } from '../lib/routes';
import { mainNav } from '../lib/site-map';
import { PLATFORM_LOGIN_URL } from '../lib/site';

interface Props {
  locale?: Locale;
}

const { locale: localeProp } = Astro.props;
const path = Astro.url.pathname;
const locale = localeProp ?? getLocaleFromPath(path);
const m = t(locale);
const home = `/${locale}`;
const nav = mainNav[locale];
const alternatePath = getAlternateLocalePath(path);
const alternateLabel = locale === 'vi' ? 'EN' : 'VI';
const alternateTitle = locale === 'vi' ? m.nav.langEn : m.nav.langVi;
const contact = contactPath(locale);
const isHome = path === home || path === `${home}/`;

function isActive(href: string): boolean {
  if (href === home) return isHome;
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={home} class="logo">
      <img class="logo-img" src="/images/logo-kit.png" alt={m.meta.siteName} width="200" height="48" decoding="async" />
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{m.nav.menuOpen}</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" data-nav>
      <div class="nav-links">
        <div class="nav-group" class:list={{ active: isHome }}>
          <a class="nav-top" href={home}>{m.nav.home}</a>
        </div>
        <div class="nav-group">
          <a class="nav-top" href={`${home}/#platform`}>{m.nav.platform}</a>
        </div>
        {
          nav.map((group) => (
            <div class="nav-group" class:list={{ active: isActive(group.href) }}>
              <a class="nav-top" href={group.href}>
                {group.label}
              </a>
              {group.items && (
                <div class="nav-dropdown">
                  {group.items.map((item) => (
                    <a href={item.href}>{item.label}</a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      <div class="nav-actions">
        <a
          class="lang-switch"
          href={alternatePath}
          hreflang={locale === 'vi' ? 'en' : 'vi'}
          lang={locale === 'vi' ? 'en' : 'vi'}
          title={alternateTitle}
        >
          <Icon name="globe" size={17} />
          <span>{alternateLabel}</span>
        </a>
        <a class="nav-login" href={PLATFORM_LOGIN_URL} target="_blank" rel="noopener noreferrer">{m.nav.login}</a>
        <a href={contact} class="nav-cta">{m.nav.contactCta}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .logo-img {
    width: auto;
    height: 42px;
    max-width: min(200px, 50vw);
    object-fit: contain;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    margin-inline: auto;
    background: var(--color-primary);
    border-radius: 2px;
  }

  .nav {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.86rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin-inline: auto;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-group {
    position: relative;
  }

  .nav-top {
    display: inline-block;
    color: #475569;
    text-decoration: none;
    padding: 0.5rem 0.6rem;
    font-weight: 600;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nav-group:hover .nav-top,
  .nav-group.active .nav-top {
    color: var(--color-primary);
  }

  .nav-group.active .nav-top {
    position: relative;
  }

  .nav-group.active .nav-top::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 230px;
    padding: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(11, 37, 69, 0.12);
    z-index: 60;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    display: grid;
    gap: 0.15rem;
  }

  .nav-dropdown a {
    display: block;
    padding: 0.45rem 0.65rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 500;
  }

  .nav-dropdown a:hover {
    background: #eef4ff;
    color: var(--color-primary);
    text-decoration: none;
  }

  .nav-cta {
    background: var(--color-primary);
    color: #fff !important;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }

  .nav-login {
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-login:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    padding: 0.4rem 0.55rem;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-muted);
  }

  .lang-switch:hover {
    color: var(--color-primary);
    background: #eef4ff;
    text-decoration: none;
  }

  @media (max-width: 1080px) {
    .nav-top {
      padding-inline: 0.45rem;
    }
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding: 0.75rem 1rem 1.25rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow);
      max-height: 80vh;
      overflow-y: auto;
    }

    .nav.is-open {
      display: flex;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      margin-inline: 0;
    }

    .nav-actions {
      flex-wrap: wrap;
    }

    .nav-dropdown {
      display: grid;
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0.5rem 0.75rem;
      min-width: 0;
    }

    .nav-group.active .nav-top::after {
      display: none;
    }

    .header-inner {
      position: relative;
      flex-wrap: wrap;
    }
  }
</style>
