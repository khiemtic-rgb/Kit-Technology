---
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n';
import type { homeContent } from '../../lib/home-content';
import { getInsightSlug, getPublishedInsightsForLocale, insightBasePath, insightPostPath } from '../../lib/insights';
import { formatPublishDate } from '../../lib/publish';
import { getPage } from '../../lib/site-map';

interface Props {
  insights: ReturnType<typeof homeContent>['insights'];
  locale: Locale;
  limit?: number;
}

const { insights, locale, limit = 3 } = Astro.props;
const posts = (await getPublishedInsightsForLocale(locale)).slice(0, limit);

function categoryLabel(category: string): string {
  return getPage(locale, `${insightBasePath(locale)}/${category}`)?.title[locale] ?? category;
}
---

{
  posts.length > 0 && (
    <section class="section insights">
      <div class="container">
        <div class="insights-head">
          <h2 class="section-title">{insights.title}</h2>
          <a class="insights-all" href={insights.href}>
            {insights.cta}
            <Icon name="arrowRight" size={16} />
          </a>
        </div>

        <div class="insights-grid">
          {posts.map((post) => (
            <a class="insight-tile" href={insightPostPath(locale, post.data.category, getInsightSlug(post))}>
              <span class="insight-thumb">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt="" width="420" height="240" loading="lazy" decoding="async" />
                ) : (
                  <span class="insight-thumb-fallback" aria-hidden="true" />
                )}
              </span>
              <span class="insight-body">
                <span class="insight-badge">{categoryLabel(post.data.category)}</span>
                <span class="insight-title">{post.data.title}</span>
                <span class="insight-meta">
                  <span class="insight-date">{formatPublishDate(post.data.publishDate, locale)}</span>
                  <span class="insight-more">
                    {insights.readMore}
                    <Icon name="arrowRight" size={14} />
                  </span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .insights {
    background: #fff;
  }

  .insights-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .insights-head .section-title {
    margin: 0;
  }

  .insights-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .insights-grid {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .insights-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .insight-tile {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .insight-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(11, 37, 69, 0.1);
    text-decoration: none;
  }

  .insight-thumb {
    display: block;
    aspect-ratio: 16 / 10;
    background: #0b2545;
  }

  .insight-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insight-thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #123256, #1668dc);
  }

  .insight-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.05rem 1.15rem;
  }

  .insight-badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #eef4ff;
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .insight-title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.4;
    color: var(--color-navy);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .insight-date {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .insight-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
