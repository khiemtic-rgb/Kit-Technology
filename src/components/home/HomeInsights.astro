---
import Icon from '../Icon.astro';
import type { Locale } from '../../i18n';
import type { homeContent } from '../../lib/home-content';
import { getHomeNewsCards } from '../../lib/partner-news';

interface Props {
  insights: ReturnType<typeof homeContent>['insights'];
  locale: Locale;
}

const { insights, locale } = Astro.props;
const posts = await getHomeNewsCards(locale);
---

{
  posts.length > 0 && (
    <section class="section insights">
      <div class="container">
        <div class="insights-head">
          <div>
            <p class="eyebrow">{insights.eyebrow}</p>
            <h2 class="section-title">{insights.title}</h2>
          </div>
          <a class="insights-all" href={insights.href}>
            {insights.cta}
            <Icon name="arrowRight" size={16} />
          </a>
        </div>

        <div class="insights-grid">
          {posts.map((post) => (
            <a
              class="insight-tile"
              href={post.href}
              target={post.external ? '_blank' : undefined}
              rel={post.external ? 'noopener noreferrer' : undefined}
            >
              <span class="insight-thumb">
                {post.image ? (
                  <img src={post.image} alt="" width="320" height="240" loading="lazy" decoding="async" />
                ) : (
                  <span class={`insight-thumb-fallback tone-${post.badgeTone}`} aria-hidden="true" />
                )}
              </span>
              <span class="insight-body">
                <span class={`insight-badge tone-${post.badgeTone}`}>{post.badge}</span>
                <span class="insight-title">{post.title}</span>
                <time class="insight-date" datetime={post.datetime}>
                  {post.dateLabel}
                </time>
                <span class="insight-more">
                  {insights.readMore}
                  <Icon name="arrowRight" size={14} />
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .insights {
    background: #fff;
  }

  .insights-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .eyebrow {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .insights-head .section-title {
    margin: 0;
  }

  .insights-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .insights-grid {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .insights-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .insight-tile {
    display: grid;
    grid-template-columns: 42% minmax(0, 1fr);
    align-items: stretch;
    min-height: 9.75rem;
    height: 100%;
    padding: 0.7rem;
    gap: 0.85rem;
    border-radius: 18px;
    background: #f4f7fb;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .insight-tile:hover {
    transform: translateY(-2px);
    background: #eef3fa;
    box-shadow: 0 10px 28px rgba(8, 27, 58, 0.08);
    text-decoration: none;
  }

  .insight-thumb {
    position: relative;
    display: block;
    min-height: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-navy);
  }

  .insight-thumb img,
  .insight-thumb-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .insight-thumb-fallback.tone-tech {
    background: linear-gradient(135deg, #081b3a, #0a66ff);
  }

  .insight-thumb-fallback.tone-novixa {
    background: linear-gradient(135deg, #14532d, #16a34a);
  }

  .insight-thumb-fallback.tone-famixa {
    background: linear-gradient(135deg, #9a3412, #ea580c);
  }

  .insight-body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    min-width: 0;
    padding: 0.15rem 0.35rem 0.15rem 0;
  }

  .insight-badge {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .insight-badge.tone-tech,
  .insight-badge.tone-novixa {
    color: var(--color-primary);
  }

  .insight-badge.tone-famixa {
    color: #ea580c;
  }

  .insight-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 750;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    height: calc(0.98rem * 1.35 * 2);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .insight-date {
    margin-top: 0.55rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.2;
  }

  .insight-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.45rem;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--color-primary);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .insight-tile {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 0.75rem;
    }

    .insight-thumb {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }

    .insight-body {
      padding: 0.15rem 0.1rem 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-tile:hover {
      transform: none;
    }
  }
</style>
