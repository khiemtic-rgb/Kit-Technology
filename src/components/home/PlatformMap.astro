---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  platform: ReturnType<typeof homeContent>['platform'];
}

const { platform } = Astro.props;
---

<section class="section platform" id="platform">
  <div class="container">
    <h2 class="section-title section-title-center">
      {platform.title} <span class="platform-accent">{platform.titleAccent}</span>
    </h2>

    <div class="platform-strip">
      {
        platform.capabilities.map((item) => (
          <div class="platform-item">
            <span class="platform-icon">
              <Icon name={item.icon} size={22} />
            </span>
            <span class="platform-label">{item.label}</span>
          </div>
        ))
      }
    </div>

    <p class="platform-caption">{platform.caption}</p>
  </div>
</section>

<style>
  .platform {
    background: #fff;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .platform-accent {
    color: var(--color-primary);
  }

  .platform-strip {
    display: grid;
    gap: 1rem 0.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2rem;
  }

  @media (min-width: 720px) {
    .platform-strip {
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }
  }

  .platform-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-align: center;
  }

  .platform-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: #eef4ff;
    color: var(--color-primary);
  }

  .platform-label {
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-navy);
  }

  .platform-caption {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
