---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  hero: ReturnType<typeof homeContent>['hero'];
}

const { hero } = Astro.props;

/** Vị trí các chip quanh platform (chỉ dùng từ breakpoint desktop). */
const orbitPositions = [
  { top: '4%', left: '8%' },
  { top: '0%', left: '44%' },
  { top: '8%', left: '76%' },
  { top: '32%', left: '0%' },
  { top: '28%', left: '84%' },
  { top: '58%', left: '2%' },
  { top: '62%', left: '82%' },
  { top: '86%', left: '38%' },
];
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-accent">{hero.titleAccent}</span>
        <span class="hero-rest">{hero.titleRest}</span>
      </h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.primaryHref}>
          {hero.primaryCta}
          <Icon name="arrowRight" size={18} />
        </a>
        <a class="btn btn-ghost" href={hero.secondaryHref}>{hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-stage">
        <div class="hero-core">
          <span class="hero-orb">AI</span>
          <div class="hero-slab"><span>{hero.coreLabel}</span></div>
        </div>
        {
          hero.orbit.map((chip, index) => (
            <span class="hero-chip" style={`top:${orbitPositions[index]?.top};left:${orbitPositions[index]?.left}`}>
              <Icon name={chip.icon} size={16} />
              {chip.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(60rem 32rem at 78% 18%, rgba(22, 104, 220, 0.16), transparent 65%),
      linear-gradient(180deg, #f4f8ff 0%, #ffffff 100%);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3rem;
    }
  }

  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.1rem, 5.2vw, 3.35rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }

  .hero-accent {
    display: block;
    color: var(--color-primary);
  }

  .hero-rest {
    display: block;
  }

  .hero-lead {
    margin: 0 0 1.75rem;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.08rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1 / 0.86;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-stage::before {
    content: '';
    position: absolute;
    inset: 8% 6%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 55%, rgba(22, 104, 220, 0.22), transparent 62%);
  }

  .hero-core {
    position: relative;
    width: 58%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .hero-orb {
    display: grid;
    place-items: center;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #7db4ff, #1668dc 55%, #0a3d8f);
    color: #fff;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: 0.06em;
    box-shadow: 0 0 0 10px rgba(22, 104, 220, 0.12), 0 18px 38px rgba(10, 61, 143, 0.35);
    animation: heroFloat 5s ease-in-out infinite;
  }

  .hero-slab {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 3.1 / 1;
    border-radius: 50%;
    background: linear-gradient(180deg, #2f7ff0 0%, #1247a0 60%, #0a2e6d 100%);
    box-shadow: 0 26px 55px rgba(10, 61, 143, 0.4);
  }

  .hero-slab::before {
    content: '';
    position: absolute;
    inset: 12% 8%;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
  }

  .hero-slab span {
    color: #fff;
    font-weight: 700;
    font-size: clamp(0.72rem, 1.6vw, 0.95rem);
    letter-spacing: 0.14em;
  }

  .hero-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(22, 104, 220, 0.16);
    box-shadow: 0 10px 24px rgba(11, 37, 69, 0.1);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
  }

  .hero-chip :global(svg) {
    color: var(--color-primary);
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb {
      animation: none;
    }
  }

  @media (max-width: 899px) {
    .hero-stage {
      aspect-ratio: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      padding-top: 0.5rem;
    }

    .hero-stage::before {
      inset: 0 10% 42%;
    }

    .hero-core {
      flex: 0 0 100%;
      width: min(100%, 320px);
      margin-bottom: 1.25rem;
    }

    .hero-chip {
      position: static;
    }
  }
</style>
