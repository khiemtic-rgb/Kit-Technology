---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  hero: ReturnType<typeof homeContent>['hero'];
}

const { hero } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-brand">{hero.brand}</span>
        <span class="hero-accent">{hero.titleAccent}</span>
        <span class="hero-rest">{hero.titleRest}</span>
      </h1>
      <p class="hero-lead">{hero.lead}</p>
      <a class="btn btn-primary hero-cta" href={hero.primaryHref}>
        {hero.primaryCta}
        <Icon name="arrowRight" size={18} />
      </a>
    </div>

    <div class="hero-visual">
      <picture class="hero-art-wrap">
        <source srcset="/images/hero-visual.webp" type="image/webp" />
        <img
          class="hero-art"
          src="/images/hero-visual.png"
          alt=""
          width="1633"
          height="1287"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: #fff;
    padding: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem 1.25rem;
    }
  }

  .hero-copy {
    max-width: 34rem;
    position: relative;
    z-index: 2;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(2.1rem, 4.5vw, 3.35rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: var(--color-navy);
  }

  .hero-brand,
  .hero-accent,
  .hero-rest {
    display: block;
  }

  .hero-accent {
    color: var(--color-primary);
  }

  .hero-lead {
    margin: 0 0 1.15rem;
    max-width: 38ch;
    color: #5b6b86;
    font-size: clamp(0.98rem, 1.5vw, 1.06rem);
    line-height: 1.6;
  }

  .hero-cta {
    border-radius: 10px;
    padding: 0.75rem 1.2rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-visual {
      justify-content: flex-end;
    }
  }

  .hero-art-wrap {
    display: block;
    width: 100%;
    max-width: 460px;
  }

  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(340px, 42vh);
    object-fit: contain;
    object-position: center right;
    animation: heroFloat 7s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -4px, 0);
    }
  }

  @media (max-width: 959px) {
    .hero-lead {
      max-width: none;
    }

    .hero-art-wrap {
      max-width: 320px;
    }

    .hero-art {
      max-height: 280px;
      object-position: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art {
      animation: none;
    }
  }
</style>
