---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  hero: ReturnType<typeof homeContent>['hero'];
}

const { hero } = Astro.props;

const orbitPositions = [
  { top: '6%', left: '58%' },
  { top: '18%', left: '8%' },
  { top: '42%', left: '0%' },
  { top: '68%', left: '8%' },
  { top: '78%', left: '58%' },
  { top: '42%', left: '78%' },
];
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-badge">{hero.badge}</p>
      <h1>{hero.title}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.primaryHref}>
          {hero.primaryCta}
          <Icon name="arrowRight" size={18} />
        </a>
        <a class="btn btn-ghost" href={hero.secondaryHref}>
          {hero.secondaryCta}
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-stage">
        <div class="hero-core">
          <div class="hero-cube hero-cube-3"></div>
          <div class="hero-cube hero-cube-2"></div>
          <div class="hero-cube hero-cube-1">
            <span>{hero.coreLabel}</span>
          </div>
        </div>
        {
          hero.orbit.map((chip, index) => (
            <span class="hero-chip" style={`top:${orbitPositions[index]?.top};left:${orbitPositions[index]?.left}`}>
              <Icon name={chip.icon} size={16} />
              {chip.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(48rem 28rem at 86% 12%, rgba(22, 104, 220, 0.12), transparent 60%),
      linear-gradient(180deg, #f7faff 0%, #ffffff 72%);
    padding: clamp(2.75rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2rem;
    }
  }

  .hero-badge {
    display: inline-flex;
    margin: 0 0 1rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(22, 104, 220, 0.35);
    border-radius: 999px;
    background: rgba(22, 104, 220, 0.06);
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2rem, 4.6vw, 3.15rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-navy);
    max-width: 14ch;
  }

  .hero-lead {
    margin: 0 0 1.75rem;
    max-width: 46ch;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.08rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1 / 0.92;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-stage::before {
    content: '';
    position: absolute;
    inset: 18% 12% 8%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, rgba(22, 104, 220, 0.22), transparent 68%);
  }

  .hero-core {
    position: relative;
    width: 58%;
    display: grid;
    place-items: center;
    perspective: 800px;
  }

  .hero-cube {
    width: 100%;
    border-radius: 18px;
    transform: rotateX(58deg) rotateZ(-45deg);
    box-shadow: 0 18px 40px rgba(10, 61, 143, 0.28);
  }

  .hero-cube-1 {
    position: relative;
    z-index: 3;
    aspect-ratio: 1.35 / 1;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #4d93f5 0%, #1668dc 48%, #0a3d8f 100%);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero-cube-1 span {
    transform: rotateZ(45deg) rotateX(-20deg);
    color: #fff;
    font-weight: 700;
    font-size: clamp(0.78rem, 1.5vw, 0.95rem);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .hero-cube-2 {
    position: absolute;
    z-index: 2;
    width: 88%;
    aspect-ratio: 1.35 / 1;
    top: -12%;
    background: linear-gradient(145deg, rgba(125, 180, 255, 0.75), rgba(22, 104, 220, 0.55));
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .hero-cube-3 {
    position: absolute;
    z-index: 1;
    width: 76%;
    aspect-ratio: 1.35 / 1;
    top: -24%;
    background: linear-gradient(145deg, rgba(184, 214, 255, 0.7), rgba(77, 147, 245, 0.45));
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .hero-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: 12px;
    background: #fff;
    border: 1px solid rgba(22, 104, 220, 0.14);
    box-shadow: 0 10px 24px rgba(11, 37, 69, 0.1);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
    animation: heroFloat 5.5s ease-in-out infinite;
  }

  .hero-chip:nth-child(odd) {
    animation-delay: 0.4s;
  }

  .hero-chip :global(svg) {
    color: var(--color-primary);
  }

  @keyframes heroFloat {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chip {
      animation: none;
    }
  }

  @media (max-width: 959px) {
    h1 {
      max-width: none;
    }

    .hero-stage {
      aspect-ratio: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.55rem;
      padding-top: 0.5rem;
    }

    .hero-core {
      flex: 0 0 100%;
      width: min(100%, 280px);
      margin-bottom: 1.5rem;
    }

    .hero-chip {
      position: static;
    }
  }
</style>
