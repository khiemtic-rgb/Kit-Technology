---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  why: ReturnType<typeof homeContent>['why'];
}

const { why } = Astro.props;
---

<section class="section why">
  <div class="container why-layout">
    <h2 class="section-title">{why.title}</h2>
    <div class="why-grid">
      {
        why.items.map((item) => (
          <div class="why-item">
            <span class="why-icon">
              <Icon name={item.icon} size={22} />
            </span>
            <div>
              <p class="why-title">{item.title}</p>
              <p class="why-desc">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    background: #f5f8ff;
  }

  .why-layout {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .why-layout {
      grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.6fr);
      align-items: start;
      gap: 2.5rem;
    }
  }

  .why-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .why-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .why-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 1.1rem 1.15rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .why-icon {
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 12px;
    background: #eef4ff;
    color: var(--color-primary);
  }

  .why-title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .why-desc {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
</style>
