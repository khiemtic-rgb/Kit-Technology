---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  ecosystem: ReturnType<typeof homeContent>['ecosystem'];
}

const { ecosystem } = Astro.props;
---

<section class="section ecosystem">
  <div class="container">
    <h2 class="section-title section-title-center section-title-light">{ecosystem.title}</h2>
    <p class="section-intro section-intro-center section-intro-light">{ecosystem.intro}</p>

    <div class="ecosystem-grid">
      {
        ecosystem.cards.map((card) => (
          <a
            class="ecosystem-card"
            href={card.href}
            target={card.external ? '_blank' : undefined}
            rel={card.external ? 'noopener noreferrer' : undefined}
          >
            <span class="ecosystem-icon" style={`color:${card.accent};background:${card.accent}1f`}>
              <Icon name={card.icon} size={22} />
            </span>
            <span class="ecosystem-status">{card.status}</span>
            <h3>{card.name}</h3>
            <p class="ecosystem-kind">{card.kind}</p>
            <p class="ecosystem-desc">{card.desc}</p>
            <span class="ecosystem-more">
              {ecosystem.more}
              <Icon name="arrowRight" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ecosystem {
    background: linear-gradient(180deg, #0b2545 0%, #102f56 100%);
  }

  .ecosystem-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 208px), 1fr));
  }

  .ecosystem-card {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 1.25rem;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-navy);
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .ecosystem-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(3, 15, 33, 0.35);
    text-decoration: none;
  }

  .ecosystem-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    margin-bottom: 0.9rem;
  }

  .ecosystem-status {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #eef4ff;
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .ecosystem-card h3 {
    margin: 0 0 0.15rem;
    font-size: 1.1rem;
  }

  .ecosystem-kind {
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .ecosystem-desc {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .ecosystem-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
