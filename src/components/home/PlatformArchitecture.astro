---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  platform: ReturnType<typeof homeContent>['platform'];
}

const { platform } = Astro.props;
---

<section class="section platform" id="platform">
  <div class="container">
    <div class="platform-head">
      <p class="eyebrow">{platform.eyebrow}</p>
      <h2 class="section-title">{platform.title}</h2>
    </div>

    <ol class="arch">
      {
        platform.layers.map((layer, index) => (
          <li class="arch-item" style={`--i:${index}`}>
            <div class="arch-card">
              <span class="arch-icon">
                <Icon name={layer.icon} size={36} />
              </span>
              <span class="arch-label">{layer.label}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .platform {
    background: var(--color-gray);
    padding-top: clamp(2rem, 4.5vw, 3.25rem);
    padding-bottom: clamp(2rem, 4.5vw, 3.25rem);
  }

  .platform-head {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .platform-head .section-title {
    margin: 0;
    font-size: clamp(1.9rem, 3.6vw, 2.45rem);
    letter-spacing: -0.03em;
    color: var(--color-navy);
  }

  .arch {
    --card: 7.25rem;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 72rem;
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .arch::before {
    content: '';
    position: absolute;
    left: calc(var(--card) / 2);
    right: calc(var(--card) / 2);
    top: 50%;
    border-top: 2px dashed #9bb8ef;
    transform: translateY(-50%);
    z-index: 0;
    pointer-events: none;
  }

  .arch-item {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    animation: fadeUp 0.55s ease both;
    animation-delay: calc(var(--i) * 70ms);
  }

  .arch-card {
    width: var(--card);
    min-height: var(--card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.85rem 0.5rem;
    border-radius: 18px;
    background: #fff;
    border: 1px solid #e6ebf4;
    box-shadow: 0 8px 22px rgba(8, 27, 58, 0.06);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .arch-card:hover {
    transform: translateY(-3px);
    border-color: rgba(10, 102, 255, 0.28);
    box-shadow: 0 14px 28px rgba(8, 27, 58, 0.1);
  }

  .arch-icon {
    display: grid;
    place-items: center;
    color: var(--color-primary);
  }

  .arch-label {
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    text-align: center;
    line-height: 1.15;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .arch {
      --card: 6.25rem;
      gap: 0.35rem;
    }

    .arch-label {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 700px) {
    .arch {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.9rem;
      justify-items: center;
    }

    .arch::before {
      display: none;
    }

    .arch-card {
      width: 100%;
      max-width: 7rem;
      min-height: 6.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-item {
      animation: none;
    }

    .arch-card:hover {
      transform: none;
    }
  }
</style>
