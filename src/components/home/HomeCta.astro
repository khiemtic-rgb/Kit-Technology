---
import Icon from '../Icon.astro';
import type { homeContent } from '../../lib/home-content';

interface Props {
  cta: ReturnType<typeof homeContent>['cta'];
}

const { cta } = Astro.props;
---

<section class="section home-cta">
  <div class="container home-cta-inner">
    <div>
      <h2>{cta.title}</h2>
      <p>{cta.desc}</p>
    </div>
    <div class="home-cta-actions">
      <a class="btn btn-primary" href={cta.primaryHref}>
        {cta.primaryCta}
        <Icon name="arrowRight" size={18} />
      </a>
      <a class="btn btn-ghost" href={cta.secondaryHref}>{cta.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .home-cta {
    background: #f5f8ff;
  }

  .home-cta-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 20px;
    background: linear-gradient(135deg, #0b2545 0%, #1247a0 100%);
    color: #fff;
  }

  @media (min-width: 860px) {
    .home-cta-inner {
      grid-template-columns: 1.4fr auto;
    }
  }

  .home-cta h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.35rem, 3vw, 1.85rem);
  }

  .home-cta p {
    margin: 0;
    max-width: 56ch;
    color: #c6d7ee;
  }

  .home-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-cta-actions :global(.btn-ghost) {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
  }

  .home-cta-actions :global(.btn-ghost:hover) {
    background: rgba(255, 255, 255, 0.2);
  }
</style>
