---
import Icon from '../Icon.astro';
import type { IconName } from '../../lib/icons';

const nodes: { label: string; icon: IconName; angle: number }[] = [
  { label: 'AI', icon: 'ai', angle: -90 },
  { label: 'Workflow', icon: 'workflow', angle: -45 },
  { label: 'Storage', icon: 'database', angle: 0 },
  { label: 'Analytics', icon: 'analytics', angle: 45 },
  { label: 'Integration', icon: 'puzzle', angle: 90 },
  { label: 'Notification', icon: 'bell', angle: 135 },
  { label: 'API', icon: 'code', angle: 180 },
  { label: 'Identity', icon: 'identity', angle: 225 },
];

const radius = 40; // % of hub box
---

<div class="phub">
  <div class="phub-glow" aria-hidden="true"></div>
  <div class="phub-orbit" aria-hidden="true"></div>
  <div class="phub-orbit phub-orbit-2" aria-hidden="true"></div>

  <svg class="phub-spokes" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    {
      nodes.map((node) => {
        const rad = (node.angle * Math.PI) / 180;
        const x2 = 50 + Math.cos(rad) * radius;
        const y2 = 50 + Math.sin(rad) * radius;
        return (
          <line
            x1="50"
            y1="50"
            x2={x2.toFixed(2)}
            y2={y2.toFixed(2)}
            stroke="rgba(10, 102, 255, 0.3)"
            stroke-width="0.4"
            stroke-dasharray="1.3 1.2"
          />
        );
      })
    }
  </svg>

  <div class="phub-core" aria-hidden="true">
    <div class="phub-pedestal"></div>
    <div class="phub-cube">
      <span>KIT<br />Platform</span>
    </div>
  </div>

  <ul class="phub-nodes">
    {
      nodes.map((node) => {
        const rad = (node.angle * Math.PI) / 180;
        const left = 50 + Math.cos(rad) * radius;
        const top = 50 + Math.sin(rad) * radius;
        return (
          <li style={`left: ${left.toFixed(2)}%; top: ${top.toFixed(2)}%`}>
            <span class="phub-tile">
              <Icon name={node.icon} size={38} strokeWidth={1.85} />
              <em>{node.label}</em>
            </span>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .phub {
    --hub: min(100%, 580px);
    position: relative;
    width: var(--hub);
    aspect-ratio: 1.08 / 1;
    margin-left: auto;
    color: var(--color-primary);
  }

  .phub-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 42%;
    height: 42%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(10, 102, 255, 0.16) 0%, transparent 70%);
    pointer-events: none;
  }

  .phub-orbit,
  .phub-orbit-2 {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 76%;
    height: 76%;
    translate: -50% -50%;
    border: 1.5px dashed rgba(10, 102, 255, 0.24);
    border-radius: 50%;
    pointer-events: none;
  }

  .phub-orbit-2 {
    width: 56%;
    height: 56%;
    border-color: rgba(10, 102, 255, 0.14);
  }

  .phub-spokes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .phub-core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -54%;
    display: grid;
    place-items: center;
    z-index: 2;
  }

  .phub-pedestal {
    width: 7rem;
    height: 7rem;
    border-radius: 1rem;
    background: linear-gradient(180deg, #ffffff 0 46%, #dbeafe 46% 76%, #bfdbfe 76% 100%);
    box-shadow:
      0 18px 36px rgba(10, 102, 255, 0.18),
      0 0 0 1px rgba(10, 102, 255, 0.08);
    transform: rotateX(55deg) rotateZ(45deg);
  }

  .phub-cube {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -68%;
    width: var(--hub-cube);
    height: var(--hub-cube);
    border-radius: 0.9rem;
    display: grid;
    place-items: center;
    text-align: center;
    color: #fff;
    font-weight: 800;
    font-size: var(--hub-cube-font);
    line-height: 1.15;
    letter-spacing: -0.02em;
    background: linear-gradient(145deg, #5a9cff 0%, #0a66ff 48%, #084fc7 100%);
    box-shadow:
      0 16px 28px rgba(10, 102, 255, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .phub-cube::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.28), transparent 42%);
    pointer-events: none;
  }

  .phub-nodes {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
  }

  .phub-nodes li {
    position: absolute;
    width: 0;
    height: 0;
    z-index: 3;
  }

  .phub-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    width: var(--hub-label-tile);
    height: var(--hub-label-tile);
    margin: calc(var(--hub-label-tile) / -2) 0 0 calc(var(--hub-label-tile) / -2);
    border-radius: 1.05rem;
    background: #fff;
    border: 1px solid rgba(10, 102, 255, 0.14);
    box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
    color: var(--color-primary);
  }

  .phub-tile :global(svg) {
    width: var(--hub-node-icon);
    height: var(--hub-node-icon);
    flex-shrink: 0;
  }

  .phub-tile em {
    font-style: normal;
    font-size: var(--hub-label-font);
    font-weight: 700;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-align: center;
    max-width: 5.2rem;
  }

  @media (max-width: 640px) {
    .phub {
      --hub: min(100%, 360px);
      margin-inline: auto;
    }

    .phub-tile {
      width: 4.65rem;
      height: 4.65rem;
      margin: -2.325rem 0 0 -2.325rem;
      border-radius: 0.95rem;
      gap: 0.18rem;
    }

    .phub-tile :global(svg) {
      width: 1.85rem;
      height: 1.85rem;
    }

    .phub-tile em {
      font-size: 0.62rem;
    }

    .phub-cube {
      width: 4.3rem;
      height: 4.3rem;
      font-size: 0.66rem;
    }

    .phub-pedestal {
      width: 5.4rem;
      height: 5.4rem;
    }
  }
</style>
