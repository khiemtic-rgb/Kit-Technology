---
---

<div class="cta-cube" aria-hidden="true">
  <div class="cta-cube-glow"></div>
  <svg class="cta-cube-svg" viewBox="0 0 220 180" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="ctaEdge" x1="40" y1="20" x2="180" y2="160" gradientUnits="userSpaceOnUse">
        <stop stop-color="#9ec5ff" />
        <stop offset="0.45" stop-color="#4da3ff" />
        <stop offset="1" stop-color="#0a66ff" />
      </linearGradient>
      <linearGradient id="ctaFace" x1="70" y1="40" x2="160" y2="140" gradientUnits="userSpaceOnUse">
        <stop stop-color="#5bb0ff" stop-opacity="0.35" />
        <stop offset="1" stop-color="#0a66ff" stop-opacity="0.08" />
      </linearGradient>
      <radialGradient id="ctaPad" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(110 148) scale(78 22)">
        <stop stop-color="#4da3ff" stop-opacity="0.75" />
        <stop offset="1" stop-color="#0a66ff" stop-opacity="0" />
      </radialGradient>
      <filter id="ctaSoft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="1.2" result="b" />
        <feMerge>
          <feMergeNode in="b" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- pedestal glow -->
    <ellipse cx="110" cy="148" rx="78" ry="16" fill="url(#ctaPad)" />
    <path
      d="M58 142h104l12 10H46l12-10z"
      fill="#0d3f8f"
      stroke="#4da3ff"
      stroke-opacity="0.55"
      stroke-width="1.2"
    />
    <path d="M62 138h96l8 8H54l8-8z" fill="#133e7a" stroke="#7eb6ff" stroke-opacity="0.45" stroke-width="1" />

    <!-- cube -->
    <g filter="url(#ctaSoft)" stroke="url(#ctaEdge)" stroke-width="2" stroke-linejoin="round">
      <!-- faces -->
      <path d="M110 38 L168 68 L168 118 L110 148 L52 118 L52 68 Z" fill="url(#ctaFace)" />
      <!-- top -->
      <path d="M110 38 L168 68 L110 98 L52 68 Z" fill="rgba(157,205,255,0.22)" />
      <!-- left -->
      <path d="M52 68 L110 98 L110 148 L52 118 Z" fill="rgba(10,102,255,0.16)" />
      <!-- right -->
      <path d="M168 68 L110 98 L110 148 L168 118 Z" fill="rgba(10,102,255,0.08)" />

      <!-- wireframe internals -->
      <path d="M110 38 V98" stroke-opacity="0.85" />
      <path d="M52 68 L110 98 L168 68" stroke-opacity="0.9" />
      <path d="M110 98 V148" stroke-opacity="0.75" />
      <path d="M52 118 L110 148 L168 118" stroke-opacity="0.7" />
      <path d="M80 55 L140 85" stroke-opacity="0.35" stroke-dasharray="3 3" />
      <path d="M80 83 L140 113" stroke-opacity="0.28" stroke-dasharray="3 3" />
      <path d="M72 98 L148 98" stroke-opacity="0.28" stroke-dasharray="3 3" />
    </g>

    <!-- spark dots -->
    <circle cx="74" cy="60" r="2.2" fill="#b7d7ff" />
    <circle cx="152" cy="86" r="2" fill="#8fc0ff" />
    <circle cx="118" cy="48" r="1.6" fill="#e8f2ff" />
  </svg>
</div>

<style>
  .cta-cube {
    position: relative;
    width: min(100%, 240px);
    margin-inline: auto;
    aspect-ratio: 220 / 180;
  }

  .cta-cube-glow {
    position: absolute;
    inset: 18% 12% 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(77, 163, 255, 0.35) 0%, transparent 70%);
    filter: blur(8px);
    pointer-events: none;
  }

  .cta-cube-svg {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }
</style>
