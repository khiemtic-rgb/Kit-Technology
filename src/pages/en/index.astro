---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import PlatformMap from '../../components/home/PlatformMap.astro';
import EcosystemSection from '../../components/home/EcosystemSection.astro';
import IndustriesSection from '../../components/home/IndustriesSection.astro';
import CapabilitiesSection from '../../components/home/CapabilitiesSection.astro';
import WhyKitSection from '../../components/home/WhyKitSection.astro';
import HomeInsights from '../../components/home/HomeInsights.astro';
import HomeCta from '../../components/home/HomeCta.astro';
import { t } from '../../i18n';
import { homeContent } from '../../lib/home-content';
import '../../styles/global.css';

const m = t('en');
const home = homeContent('en');
---

<BaseLayout title={m.meta.siteName} description={m.meta.description} locale="en" canonicalPath="/en">
  <Header slot="header" locale="en" />

  <HomeHero hero={home.hero} />
  <PlatformMap platform={home.platform} />
  <EcosystemSection ecosystem={home.ecosystem} />
  <IndustriesSection industries={home.industries} />
  <CapabilitiesSection capabilities={home.capabilities} />
  <WhyKitSection why={home.why} />
  <HomeInsights insights={home.insights} locale="en" />
  <HomeCta cta={home.cta} />

  <Footer slot="footer" locale="en" />
</BaseLayout>
