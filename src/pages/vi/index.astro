---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import FlagshipSolutions from '../../components/home/FlagshipSolutions.astro';
import PlatformArchitecture from '../../components/home/PlatformArchitecture.astro';
import TechLogos from '../../components/home/TechLogos.astro';
import HomeInsights from '../../components/home/HomeInsights.astro';
import { t } from '../../i18n';
import { homeContent } from '../../lib/home-content';

const m = t('vi');
const home = homeContent('vi');
---

<BaseLayout title={m.meta.siteName} description={m.meta.description} locale="vi" canonicalPath="/vi/">
  <Header slot="header" locale="vi" />

  <HomeHero hero={home.hero} />
  <FlagshipSolutions flagship={home.flagship} />
  <PlatformArchitecture platform={home.platform} />
  <TechLogos technology={home.technology} />
  <HomeInsights insights={home.insights} locale="vi" />

  <Footer slot="footer" locale="vi" />
</BaseLayout>
